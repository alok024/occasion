# Occasion — environment variables (names only; copy to .env.local and fill in to go live).
# With NONE of these set, the app runs in mock mode: speeches are composed locally and
# checkout completes with no real charge. The full flow works with zero keys.

# --- Text generation (Groq, OpenAI-compatible). Without it, mock speeches are composed locally. ---
GROQ_API_KEY=
# Optional override — unset uses the app's current default. If you set it, point at a live
# Groq model; the old default, llama-3.3-70b-versatile, is being decommissioned.
GROQ_MODEL=
# Optional OpenAI fallback, also used automatically on a Groq timeout or a blank completion:
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Payments (Razorpay). Without both, checkout runs in mock/test mode (no charge). ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Test keys are also honored:
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
# Required in production for /api/webhook/razorpay to verify incoming webhooks:
RAZORPAY_WEBHOOK_SECRET=

# --- Durable store (drafts + purchase entitlement, keyed by generationId). ---
# Unset = local in-memory dev store, same as today. Set one backend below to persist across
# restarts and share state across serverless instances:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# --- Voice delivery kit (self-hosted MeloTTS, e.g. the Vachix TTS service; not yet wired up). ---
# Unset = the delivery kit ships as text only (teleprompter, timed read, pronunciation guide).
MELOTTS_URL=
