# Occasion — environment variables (names only; copy to .env.local and fill in to go live).
# With NONE of these set, the app runs in mock mode: speeches are composed locally and
# checkout completes with no real charge. The full flow works with zero keys.

# --- Text generation (Groq, OpenAI-compatible). Without it, mock speeches are composed locally. ---
GROQ_API_KEY=
# Optional overrides:
GROQ_MODEL=
# Optional OpenAI fallback if you prefer it over Groq:
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Payments (Razorpay). Without both, checkout runs in mock/test mode (no charge). ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Test keys are also honored:
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
# Only needed if you wire up the Razorpay webhook:
RAZORPAY_WEBHOOK_SECRET=
